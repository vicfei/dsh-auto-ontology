{
  "name": "dsh-auto-ontology",
  "version": "0.2.0",
  "description": "Auto ontology construction for DeepSeek Harness — two-pass LLM pipeline (TBox schema from corpus, ABox assertions per document) with an evidence quote on every entity/relation, a type guard against silent drops, append-only incremental merge, conservative coreference, JSON-LD export and evidence-span queries. Zero-infra stdlib CLI + typed agent tools.",
  "type": "module",
  "bin": {
    "auto-ontology": "bin/auto-ontology.js"
  },
  "scripts": {
    "prepack": "node build.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "scripts",
    "cordis.patch.yml",
    "build.mjs",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "auto-ontology",
    "ontology",
    "knowledge-graph",
    "llm-extraction",
    "evidence-grounding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vicfei/dsh-auto-ontology.git"
  },
  "homepage": "https://github.com/vicfei/dsh-auto-ontology#readme",
  "bugs": {
    "url": "https://github.com/vicfei/dsh-auto-ontology/issues"
  },
  "license": "MIT",
  "author": "vicfei",
  "main": "./lib/index.js",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1"
  }
}